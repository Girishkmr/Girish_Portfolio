# Copy to .env.local and fill in. .env.local is gitignored — never commit it.
# See REQUIREMENTS.html §12.

# --- Supabase (Phase 2) ---------------------------------------------------
# Safe in the browser. RLS is what protects the data, not the key's secrecy.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY. Bypasses RLS entirely. Never prefix this with NEXT_PUBLIC_,
# never import it into a Client Component, and never log it.
SUPABASE_SERVICE_ROLE_KEY=

# --- Email (Phase 1) ------------------------------------------------------
RESEND_API_KEY=
# Sender. Until a domain is verified with Resend, the ONLY sender that works is
# onboarding@resend.dev, and it can only deliver to the Resend account owner's
# own address — which is fine, because that is exactly who this mail is for.
# Once D-1 (domain) is settled, verify it and switch this to your own address.
CONTACT_FROM_EMAIL=Portfolio <onboarding@resend.dev>
# Where contact-form submissions are delivered. Server-side only, never
# rendered — the public page shows no address at all (decision L-6).
CONTACT_TO_EMAIL=

# --- Cron (Phase 2) -------------------------------------------------------
# Guards /api/cron/keepalive, which stops the free Supabase project from
# auto-pausing after a week of inactivity.
CRON_SECRET=

# --- Site -----------------------------------------------------------------
# Absolute origin, used for OG images, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
